{
  "name": "@losrc/emdash-plugin-shopify",
  "version": "0.4.0",
  "description": "Shopify for Astro and EmDash: a Worker-owned cart that works without JavaScript, shop-data reading, and a product-sync admin page",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LOSRC/emdash-plugin-shopify.git"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "astro-component",
    "shopify",
    "storefront-api",
    "cloudflare"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/testing": {
      "types": "./dist/core/testing.d.ts",
      "default": "./dist/core/testing.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./components/*": "./src/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/components",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "astro": ">=6",
    "emdash": ">=1.3.1 <2"
  },
  "peerDependenciesMeta": {
    "emdash": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "tsdown": "0.23.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "sideEffects": [
    "./dist/elements/*"
  ]
}
